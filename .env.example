# Configuration names only. Supply credentials through existing environment/CI secret settings.
# This file does not enable billing, buy credits or provision services.
DEFUSE_GITLAB_URL=https://gitlab.com
DEFUSE_SANDBOX_NAMESPACES=defuse-sandbox
DEFUSE_GITLAB_TOKEN=
DEFUSE_DATABASE_URL=sqlite+aiosqlite:///./defuse.db
DEFUSE_SEED_SCENARIO=true
DEFUSE_RECORDS_DIR=records
DEFUSE_RUNNER_HOSTS={}
DEFUSE_TOKEN_VARIABLES={}
DEFUSE_KNOWN_GOOD_REFS={}
DEFUSE_AUTO_MERGE_REMEDIATION=false
DEFUSE_CREDENTIAL_BROKER_URL=http://127.0.0.1:8040
DEFUSE_CREDENTIAL_BROKER_TOKEN=
# Authority-only authentication; do not provide this to the containment engine.
DEFUSE_BROKER_GITLAB_TOKEN=
DEFUSE_BROKER_JOURNAL=records/credential-authority.db
DEFUSE_BROKER_PROVIDER_COMMANDS={}
DEFUSE_DUO_ENABLED=false
DEFUSE_VERIFICATION_WINDOW=120
DEFUSE_SINKHOLE_URL=http://127.0.0.1:8080
DEFUSE_GCP_PROJECT=
DEFUSE_GCP_ZONE=us-central1-a
DEFUSE_API_BASE=http://127.0.0.1:8000
